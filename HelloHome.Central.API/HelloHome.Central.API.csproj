<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lamar.Microsoft.DependencyInjection" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"  />
        <PackageReference Include="OpenTelemetry.Exporter.Console"  />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="Swashbuckle.AspNetCore"  />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HelloHome.Central.Common.IoC\HelloHome.Central.Common.IoC.csproj" />
      <ProjectReference Include="..\HelloHome.Central.Common.Mqtt\HelloHome.Central.Common.Mqtt.csproj" />
      <ProjectReference Include="..\HelloHome.Central.Common\HelloHome.Central.Common.csproj" />
      <ProjectReference Include="..\HelloHome.Central.Domain\HelloHome.Central.Domain.csproj" />
      <ProjectReference Include="..\HelloHome.Central.Repository\HelloHome.Central.Repository.csproj" />
    </ItemGroup>

</Project>
